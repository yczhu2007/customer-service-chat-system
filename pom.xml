<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>customer-service-chat-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>customer-service-chat-system</name>
    <description>客服聊天系统父工程</description>

    <modules>
        <module>third-party-libs</module>
        <module>commonModel</module>
        <module>businessModel</module>
        <module>application</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.46</lombok.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <shiro.version>2.0.2</shiro.version>
        <!-- JDK 26 需要更新版本的 Mockito/ByteBuddy 才能初始化 inline mock maker。 -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.18.10</byte-buddy.version>
        <minio.version>8.2.2</minio.version>
        <okhttp.version>4.12.0</okhttp.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
