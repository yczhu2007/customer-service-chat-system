<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.customerservice.mapper.ChatMessageMapper">

    <select id="findBySessionId"
            resultType="com.example.customerservice.domain.ChatMessage">

        SELECT
        id,
        session_id,
        sender_id,
        sender_role,
        type,
        content,
        client_msg_id,
        create_time

        FROM chat_message

        WHERE session_id = #{sessionId}

        ORDER BY create_time ASC

    </select>

</mapper>
