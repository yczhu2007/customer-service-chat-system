<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.customerservice.mapper.ChatSessionTagMapper">

    <resultMap id="ChatSessionTagResultMap" type="com.example.customerservice.domain.ChatSessionTag">
        <id property="sessionId" column="session_id"/>
        <id property="tag" column="tag"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.customerservice.domain.ChatSessionTag">
        INSERT INTO chat_session_tag (session_id, tag)
        VALUES (#{sessionId}, #{tag})
    </insert>

    <delete id="deleteBySessionId">
        DELETE FROM chat_session_tag
        WHERE session_id = #{sessionId}
    </delete>

    <select id="selectBySessionId" resultMap="ChatSessionTagResultMap">
        SELECT session_id, tag, create_time
        FROM chat_session_tag
        WHERE session_id = #{sessionId}
        ORDER BY create_time ASC, tag ASC
    </select>

    <select id="selectBySessionIds" resultMap="ChatSessionTagResultMap">
        SELECT session_id, tag, create_time
        FROM chat_session_tag
        WHERE session_id IN
        <foreach collection="sessionIds" item="sessionId" open="(" separator="," close=")">
            #{sessionId}
        </foreach>
        ORDER BY session_id ASC, create_time ASC, tag ASC
    </select>

</mapper>
