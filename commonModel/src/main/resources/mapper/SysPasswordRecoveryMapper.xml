<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.customerservice.mapper.SysPasswordRecoveryMapper">

    <!--
      Delete only the hash that was verified by the caller and only while it is valid.
      The affected-row count is the concurrent single-use claim result.
    -->
    <delete id="consumeRecoveryCode">
        DELETE FROM sys_password_recovery
        WHERE user_id = #{userId}
          AND recovery_hash = #{recoveryHash}
          AND expires_time &gt; #{now}
    </delete>

</mapper>
