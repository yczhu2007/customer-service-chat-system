<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>customer-service-chat-system</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>customer-service-chat-application</artifactId>
    <packaging>jar</packaging>

    <name>customer-service-chat-application</name>
    <description>客服聊天系统启动和Web接入模块</description>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>customer-service-chat-business</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>customer-service-chat-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.example</groupId>
            <artifactId>customer-service-chat-third-party-libs</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 让@TempDir位于项目target中，测试结束后由JUnit自动清理。
                         另外JDK 21+默认禁止self-attach，Mockito inline mock maker需要打开，否则报
                         "Could not self-attach to current VM"。 -->
                    <argLine>-Djava.io.tmpdir=${project.build.directory} --enable-final-field-mutation=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.customerservice.CustomerServiceChatApplication</mainClass>
                    <jvmArguments>--enable-final-field-mutation=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
